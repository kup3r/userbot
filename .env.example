# Telegram user account API credentials from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash

# Main service mode for Render
SERVICE_MODE=multi

# Control Bot token from @BotFather
CONTROL_BOT_TOKEN=123456:replace_me

# Telegram numeric IDs allowed to use admin commands
OWNER_IDS=123456789

# Generate once and keep forever:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SESSION_ENCRYPTION_KEY=replace_me

# Durable database. REQUIRED in multi mode on Render.
# Recommended: a PostgreSQL URL from Neon Free.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optional support username shown to buyers.
SUPPORT_USERNAME=@your_username

# Optional HTTP Basic auth for /admin
ADMIN_WEB_USER=admin
ADMIN_WEB_PASSWORD=replace_me

# Render automatically exposes RENDER_EXTERNAL_URL; leave PUBLIC_BASE_URL empty there.
PUBLIC_BASE_URL=

# Runtime-only filesystem. Nothing important is stored here.
DATA_DIR=/tmp/nexus-userbot
ALLOW_EPHEMERAL_SQLITE=false

COMMAND_PREFIX=.
LOG_LEVEL=INFO
EVAL_ENABLED=false
CUSTOM_MODULES_ENABLED=true
MAX_WORKERS=1

TRIAL_DAYS=3
REFERRAL_BONUS_DAYS=7

BASIC_CUSTOM_MODULES=5
PRO_CUSTOM_MODULES=20
PREMIUM_CUSTOM_MODULES=50

COMMAND_RATE_LIMIT=8
COMMAND_RATE_WINDOW=2

PLAN_BASIC_STARS=50
PLAN_BASIC_DAYS=30
PLAN_PRO_STARS=120
PLAN_PRO_DAYS=90
PLAN_PREMIUM_STARS=300
PLAN_PREMIUM_DAYS=365

# Optional local-only compatibility mode. Keep false on Render.
# ALLOW_EPHEMERAL_SQLITE=true

# Optional trusted HTTPS module store index. Leave empty to use the built-in catalog.
MODULE_STORE_INDEX_URL=

# Optional: override the Store base URL instead of using this Render service.
MODULE_STORE_BASE_URL=
